// Dramatique — PostgreSQL schema
//
// Grouped by the three systems in the Phase 1 plan:
//   UMS — User Management System   (users, preferences, devices, referrals, rewards)
//   CMS — Content Management System (categories, genres, series, episodes, blog)
//   SMS — Subscription Management System (wallets, coin ledger, packs, plans,
//         subscriptions, payment orders, webhook log)
//
// Money is stored in minor units (paise / cents) as integers — never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── ENUMS ─────────────────────────────

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum PublishStatus {
  DRAFT
  SCHEDULED // goes live automatically at publishAt
  PUBLISHED
  ARCHIVED
}

enum VideoStatus {
  PENDING // no source uploaded yet
  UPLOADED // raw file is in R2, waiting for transcode
  PROCESSING // MediaConvert job running
  READY // HLS/DASH manifests available
  FAILED
}

enum EpisodeAccessType {
  FREE
  COIN_LOCKED // unlockable with coins (or a rewarded ad); free for VIP
  VIP_ONLY
}

enum UnlockMethod {
  COINS
  AD
  ADMIN_GRANT
}

enum CoinTransactionType {
  PURCHASE
  EPISODE_UNLOCK
  DAILY_REWARD
  REFERRAL_BONUS
  WELCOME_BONUS
  AD_REWARD
  ADMIN_ADJUSTMENT
  REFUND
}

enum PaymentGateway {
  RAZORPAY
  STRIPE
}

enum PaymentType {
  COIN_PACK
  SUBSCRIPTION
}

enum PaymentStatus {
  CREATED // order created at gateway, user hasn't paid
  PENDING // payment authorised, awaiting capture/webhook
  SUCCESS
  FAILED
  REFUNDED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  PENDING // created, first charge not confirmed yet
  ACTIVE
  PAST_DUE // renewal charge failed, gateway retrying
  CANCELLED // won't renew; still entitled until currentPeriodEnd
  EXPIRED
}

enum NotificationType {
  NEW_EPISODE
  DAILY_CHECKIN
  RESUME_REMINDER
  VIP_EXPIRY
  PROMO
}

// ───────────────────────────── UMS ─────────────────────────────

model User {
  id           String     @id @default(uuid()) @db.Uuid
  firebaseUid  String     @unique @map("firebase_uid") @db.VarChar(128)
  // Firebase anonymous session — guests can browse/watch free episodes and
  // get upgraded to a real account (same uid) at first purchase.
  isGuest      Boolean    @default(true) @map("is_guest")
  displayName  String?    @map("display_name") @db.VarChar(100)
  email        String?    @unique @db.VarChar(255)
  phone        String?    @unique @db.VarChar(20)
  avatarUrl    String?    @map("avatar_url") @db.VarChar(500)
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  language     String     @default("en") @db.VarChar(10)
  referralCode String     @unique @map("referral_code") @db.VarChar(16)
  // Denormalised VIP entitlement, written in the same transaction as any
  // Subscription change. VIP ⇔ vipUntil > now(). Source of truth for history
  // is the subscriptions table.
  vipUntil     DateTime?  @map("vip_until")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  wallet                  CoinWallet?
  coinTransactions        CoinTransaction[]
  unlockedEpisodes        UserUnlockedEpisode[]
  watchProgress           WatchProgress[]
  savedSeries             SavedSeries[]
  genrePreferences        UserGenrePreference[]
  devices                 UserDevice[]
  notificationPreferences NotificationPreference[]
  dailyCheckIns           DailyCheckIn[]
  adRewardViews           AdRewardView[]
  referralsMade           Referral[]               @relation("Referrer")
  referralReceived        Referral?                @relation("Referee")
  subscriptions           Subscription[]
  paymentOrders           PaymentOrder[]
  blogPosts               BlogPost[]
  notificationsSent       Notification[]

  @@index([createdAt])
  @@map("users")
}

// Onboarding genre picker ("choose 3 genres")
model UserGenrePreference {
  userId  String @map("user_id") @db.Uuid
  genreId Int    @map("genre_id")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([userId, genreId])
  @@map("user_genre_preferences")
}

// FCM push tokens — one user can have several browsers/devices
model UserDevice {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  fcmToken   String   @unique @map("fcm_token") @db.VarChar(512)
  platform   String   @db.VarChar(20) // web | android | ios
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_devices")
}

// Per-category opt-out. A missing row means "enabled".
model NotificationPreference {
  userId  String           @map("user_id") @db.Uuid
  type    NotificationType
  enabled Boolean          @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
  @@map("notification_preferences")
}

model DailyCheckIn {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  checkInDate  DateTime @map("check_in_date") @db.Date
  streak       Int      @default(1)
  coinsAwarded Int      @map("coins_awarded")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, checkInDate])
  @@map("daily_check_ins")
}

model Referral {
  id           String    @id @default(uuid()) @db.Uuid
  referrerId   String    @map("referrer_id") @db.Uuid
  refereeId    String    @unique @map("referee_id") @db.Uuid // a user can only be referred once
  coinsAwarded Int       @default(0) @map("coins_awarded")
  // Reward is paid when the referee converts to a real account, not on
  // anonymous signup — otherwise guest sessions are free coin farms.
  rewardedAt   DateTime? @map("rewarded_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@map("referrals")
}

// Rewarded-ad views, counted per day against the daily ad limit
model AdRewardView {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  episodeId String?  @map("episode_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("ad_reward_views")
}

// ───────────────────────────── CMS ─────────────────────────────

// Top-level browse category (Romance, Thriller, …)
model Category {
  id           Int      @id @default(autoincrement())
  name         String   @unique @db.VarChar(100)
  slug         String   @unique @db.VarChar(100)
  icon         String?  @db.VarChar(16)
  color        String?  @db.VarChar(16)
  description  String?  @db.VarChar(255)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  genres Genre[]
  series Series[]

  @@map("categories")
}

// Sub-category / genre (CEO Romance, Revenge, Werewolf, …) — what the
// consumer app shows as "genre" and the onboarding picker offers.
model Genre {
  id           Int     @id @default(autoincrement())
  categoryId   Int?    @map("category_id")
  name         String  @unique @db.VarChar(100)
  slug         String  @unique @db.VarChar(100)
  icon         String? @db.VarChar(16)
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  category        Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  series          SeriesGenre[]
  userPreferences UserGenrePreference[]

  @@map("genres")
}

model Series {
  id             String        @id @default(uuid()) @db.Uuid
  title          String        @db.VarChar(255)
  slug           String        @unique @db.VarChar(255)
  synopsis       String?       @db.Text
  thumbnailUrl   String        @map("thumbnail_url") @db.VarChar(500) // 2:3 poster
  bannerUrl      String?       @map("banner_url") @db.VarChar(500) // hero / 16:9
  trailerKey     String?       @map("trailer_key") @db.VarChar(500)
  language       String        @default("en") @db.VarChar(10)
  categoryId     Int?          @map("category_id")
  tags           String[]      @default([])
  status         PublishStatus @default(DRAFT)
  publishAt      DateTime?     @map("publish_at")
  publishedAt    DateTime?     @map("published_at")
  isFeatured     Boolean       @default(false) @map("is_featured") // hero banner
  isVipExclusive Boolean       @default(false) @map("is_vip_exclusive")
  releaseYear    Int?          @map("release_year")
  viewCount      Int           @default(0) @map("view_count")
  ratingAvg      Decimal       @default(0) @map("rating_avg") @db.Decimal(2, 1)
  ratingCount    Int           @default(0) @map("rating_count")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  genres        SeriesGenre[]
  episodes      Episode[]
  savedBy       SavedSeries[]
  watchProgress WatchProgress[]

  @@index([status, publishedAt])
  @@index([status, publishAt])
  @@map("series")
}

model SeriesGenre {
  seriesId String @map("series_id") @db.Uuid
  genreId  Int    @map("genre_id")

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  genre  Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([seriesId, genreId])
  @@index([genreId])
  @@map("series_genres")
}

model Episode {
  id              String            @id @default(uuid()) @db.Uuid
  seriesId        String            @map("series_id") @db.Uuid
  episodeNumber   Int               @map("episode_number")
  title           String            @db.VarChar(255)
  description     String?           @db.Text
  thumbnailUrl    String?           @map("thumbnail_url") @db.VarChar(500)
  durationSeconds Int               @default(0) @map("duration_seconds")
  // Access is decided per episode (not a series-wide "lock from" number) so
  // admins can mix free teasers, coin episodes and VIP-only finales.
  accessType      EpisodeAccessType @default(COIN_LOCKED) @map("access_type")
  coinPrice       Int               @default(5) @map("coin_price")
  status          PublishStatus     @default(DRAFT)
  publishAt       DateTime?         @map("publish_at")
  publishedAt     DateTime?         @map("published_at")
  viewCount       Int               @default(0) @map("view_count")

  // Video pipeline — R2 object keys, not URLs. Playback URLs are built (and
  // signed for locked episodes) at request time so a leaked manifest link
  // can't bypass the paywall.
  videoStatus       VideoStatus @default(PENDING) @map("video_status")
  sourceKey         String?     @map("source_key") @db.VarChar(500)
  hlsManifestKey    String?     @map("hls_manifest_key") @db.VarChar(500)
  dashManifestKey   String?     @map("dash_manifest_key") @db.VarChar(500)
  subtitlesKey      String?     @map("subtitles_key") @db.VarChar(500)
  mediaConvertJobId String?     @map("media_convert_job_id") @db.VarChar(100)
  videoError        String?     @map("video_error") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  series        Series                @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  unlockedBy    UserUnlockedEpisode[]
  watchProgress WatchProgress[]
  adRewardViews AdRewardView[]

  @@unique([seriesId, episodeNumber])
  @@index([status, publishAt])
  @@map("episodes")
}

model BlogPost {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique @db.VarChar(255)
  title       String        @db.VarChar(255)
  excerpt     String?       @db.VarChar(500)
  content     String        @db.Text
  coverUrl    String?       @map("cover_url") @db.VarChar(500)
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")
  authorId    String?       @map("author_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@map("blog_posts")
}

// ─────────────────── Viewing: unlocks, progress, My List ───────────────────

model UserUnlockedEpisode {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  episodeId  String       @map("episode_id") @db.Uuid
  method     UnlockMethod @default(COINS)
  coinsSpent Int          @default(0) @map("coins_spent")
  unlockedAt DateTime     @default(now()) @map("unlocked_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@map("user_unlocked_episodes")
}

// Durable copy of watch progress. Hot writes land in Redis first (Phase 2
// "sync within 2 seconds") and are flushed here.
model WatchProgress {
  userId              String   @map("user_id") @db.Uuid
  episodeId           String   @map("episode_id") @db.Uuid
  seriesId            String   @map("series_id") @db.Uuid // denormalised for Continue Watching
  lastPositionSeconds Int      @map("last_position_seconds")
  completed           Boolean  @default(false)
  updatedAt           DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  series  Series  @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([userId, episodeId])
  @@index([userId, updatedAt])
  @@map("watch_progress")
}

// "My List"
model SavedSeries {
  userId    String   @map("user_id") @db.Uuid
  seriesId  String   @map("series_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([userId, seriesId])
  @@index([userId, createdAt])
  @@map("saved_series")
}

// ───────────────────────────── SMS ─────────────────────────────

// Balance is a cached sum of the ledger. Never write it directly — always
// debit with a conditional update (`balance >= cost`) inside the same
// transaction that inserts the CoinTransaction row.
model CoinWallet {
  userId    String   @id @map("user_id") @db.Uuid
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coin_wallets")
}

// Append-only coin ledger
model CoinTransaction {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  amount         Int // +credit / -debit
  balanceAfter   Int                 @map("balance_after")
  type           CoinTransactionType
  description    String?             @db.VarChar(255)
  referenceId    String?             @map("reference_id") @db.VarChar(100) // episode / order / referral id
  // Guards against double-crediting on webhook retries or double-taps
  idempotencyKey String?             @unique @map("idempotency_key") @db.VarChar(150)
  createdAt      DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("coin_transactions")
}

model CoinPack {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(100)
  coins         Int
  bonusCoins    Int      @default(0) @map("bonus_coins")
  priceInrPaise Int      @map("price_inr_paise")
  priceUsdCents Int?     @map("price_usd_cents")
  isPopular     Boolean  @default(false) @map("is_popular")
  isActive      Boolean  @default(true) @map("is_active")
  displayOrder  Int      @default(0) @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at")

  paymentOrders PaymentOrder[]

  @@map("coin_packs")
}

model SubscriptionPlan {
  id             Int             @id @default(autoincrement())
  name           String          @db.VarChar(100)
  interval       BillingInterval
  priceInrPaise  Int             @map("price_inr_paise")
  priceUsdCents  Int?            @map("price_usd_cents")
  razorpayPlanId String?         @unique @map("razorpay_plan_id") @db.VarChar(100)
  stripePriceId  String?         @unique @map("stripe_price_id") @db.VarChar(100)
  features       String[]        @default([])
  isActive       Boolean         @default(true) @map("is_active")
  displayOrder   Int             @default(0) @map("display_order")
  createdAt      DateTime        @default(now()) @map("created_at")

  subscriptions Subscription[]
  paymentOrders PaymentOrder[]

  @@map("subscription_plans")
}

model Subscription {
  id                    String             @id @default(uuid()) @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  planId                Int                @map("plan_id")
  gateway               PaymentGateway
  gatewaySubscriptionId String             @unique @map("gateway_subscription_id") @db.VarChar(255)
  status                SubscriptionStatus @default(PENDING)
  currentPeriodStart    DateTime?          @map("current_period_start")
  currentPeriodEnd      DateTime?          @map("current_period_end")
  cancelAtPeriodEnd     Boolean            @default(false) @map("cancel_at_period_end")
  cancelledAt           DateTime?          @map("cancelled_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          SubscriptionPlan @relation(fields: [planId], references: [id])
  paymentOrders PaymentOrder[]

  @@index([userId, status])
  @@index([status, currentPeriodEnd]) // expiry sweeps + "expires in 3 days" pushes
  @@map("subscriptions")
}

model PaymentOrder {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  gateway          PaymentGateway
  gatewayOrderId   String         @unique @map("gateway_order_id") @db.VarChar(255)
  gatewayPaymentId String?        @unique @map("gateway_payment_id") @db.VarChar(255)
  type             PaymentType
  status           PaymentStatus  @default(CREATED)
  amountMinor      Int            @map("amount_minor") // paise / cents
  currency         String         @default("INR") @db.VarChar(3)
  coinPackId       Int?           @map("coin_pack_id")
  planId           Int?           @map("plan_id")
  subscriptionId   String?        @map("subscription_id") @db.Uuid
  coinsCredited    Int?           @map("coins_credited")
  failureReason    String?        @map("failure_reason") @db.VarChar(500)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  user         User              @relation(fields: [userId], references: [id])
  coinPack     CoinPack?         @relation(fields: [coinPackId], references: [id])
  plan         SubscriptionPlan? @relation(fields: [planId], references: [id])
  subscription Subscription?     @relation(fields: [subscriptionId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("payment_orders")
}

// Every inbound gateway webhook, stored before processing. The unique
// (gateway, eventId) makes retries no-ops.
model WebhookEvent {
  id          String         @id @default(uuid()) @db.Uuid
  gateway     PaymentGateway
  eventId     String         @map("event_id") @db.VarChar(255)
  eventType   String         @map("event_type") @db.VarChar(100)
  payload     Json
  processedAt DateTime?      @map("processed_at")
  error       String?        @db.Text
  receivedAt  DateTime       @default(now()) @map("received_at")

  @@unique([gateway, eventId])
  @@map("webhook_events")
}

// ───────────────────────────── Ops ─────────────────────────────

// Admin broadcast log (push delivery itself goes through FCM)
model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  type       NotificationType
  title      String           @db.VarChar(150)
  body       String           @db.VarChar(500)
  deepLink   String?          @map("deep_link") @db.VarChar(500)
  audience   String           @default("all") @db.VarChar(50) // all | vip | non_vip | genre:<slug>
  sentById   String?          @map("sent_by_id") @db.Uuid
  sentAt     DateTime?        @map("sent_at")
  recipients Int              @default(0)
  createdAt  DateTime         @default(now()) @map("created_at")

  sentBy User? @relation(fields: [sentById], references: [id], onDelete: SetNull)

  @@map("notifications")
}

// Tunable business numbers (welcome bonus, daily reward, ad limit, …) so the
// admin settings page can change them without a deploy.
model AppSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
