PORT=4000
# Sites allowed to call the API. Comma-separated; "*" matches one part of a
# host name, e.g. for Vercel previews:
# CORS_ORIGIN=https://dramatique-shorts.vercel.app,https://dramatique-*-dramatique-team.vercel.app
CORS_ORIGIN=http://localhost:3000

# PostgreSQL on Supabase (Mumbai / ap-south-1)
# Dashboard -> Connect -> ORMs -> Prisma. Copy both strings and put your DB password in place of [YOUR-PASSWORD].
# App traffic: transaction pooler, port 6543, must keep ?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations: session pooler, port 5432
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Redis
REDIS_URL="redis://localhost:6379"

# Firebase Admin SDK — only the project ID is needed to verify logins.
# CLIENT_EMAIL / PRIVATE_KEY are optional (service-account key; blocked by our org policy).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudflare R2 (S3-compatible) — R2 > Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public bucket: posters, banners, processed HLS video (served via CDN)
R2_MEDIA_BUCKET=dramatique-media
# Private bucket: raw video uploads from the admin panel (never public)
R2_UPLOADS_BUCKET=dramatique-uploads
# Public URL of the media bucket (r2.dev URL for now, custom domain later)
R2_PUBLIC_BASE_URL=

# Media Worker (workers/media) — signed, short-lived video URLs.
# Leave empty for local dev against the open r2.dev URL. When set, point
# R2_PUBLIC_BASE_URL at the Worker (e.g. https://media-dramatique.<account>.workers.dev)
# and use the same value as the Worker secret. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEDIA_TOKEN_SECRET=
# How long a playback URL works, in seconds (default 7200 = 2 h)
MEDIA_TOKEN_TTL_SECONDS=
